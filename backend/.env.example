# ==============================================================================
# ATHINA BACKEND CONFIGURATION (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. ROTATING GEMINI API KEYS (COMMA-SEPARATED)
# ------------------------------------------------------------------------------
# Add as many Gemini API keys as you have, separated by commas.
# KeyPool will automatically rotate through them and cooldown exhausted keys:
GEMINI_API_KEYS=your_gemini_key_1,your_gemini_key_2,your_gemini_key_3

# Primary and Fallback Gemini Models (Left to right priority):
GEMINI_MODELS=gemini-2.5-flash,gemini-2.0-flash,gemini-1.5-flash

# ------------------------------------------------------------------------------
# 2. GROQ API KEYS & OPENAI 120B MODEL
# ------------------------------------------------------------------------------
# Groq keys for OpenAI 120B open-weight model and Whisper STT:
GROQ_API_KEYS=your_groq_key_1,your_groq_key_2

# Using OpenAI GPT-OSS 120B on Groq (replaces LLaMA 3.3 70B):
GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b,llama-3.1-8b-instant

# Voice Speech-to-Text Model on Groq:
GROQ_STT_MODEL=whisper-large-v3

# ------------------------------------------------------------------------------
# 3. REAL-TIME WEB SEARCH VIA TAVILY
# ------------------------------------------------------------------------------
# Get your free API key at https://tavily.com:
TAVILY_API_KEY=tvly-your_tavily_api_key_here

# ------------------------------------------------------------------------------
# 4. NANO BANANA IMAGE GENERATION ENGINE
# ------------------------------------------------------------------------------
# Reference-driven Nano Banana using 575 curated photos and Imagen 3:
IMAGE_GEN_MODEL=nano-banana-reference,imagen-3.0-generate-002
IMAGE_DAILY_LIMIT=20

# ------------------------------------------------------------------------------
# 5. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Local SQLite:
DATABASE_URL=sqlite+aiosqlite:///./athina.db

# Production Oracle VM (PostgreSQL with pgvector):
# DATABASE_URL=postgresql+asyncpg://athina:athina_secure_password@localhost:5432/athina

# ------------------------------------------------------------------------------
# 6. TELEGRAM BOT (FOR MOBILE SYNC & NIGHTLY BACKUPS)
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=
TELEGRAM_STORAGE_CHANNEL_ID=

# ------------------------------------------------------------------------------
# 7. ADMIN SECURITY
# ------------------------------------------------------------------------------
ADMIN_SECRET=A240504
