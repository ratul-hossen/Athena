# Production Caddy Reverse Proxy for Athina
# Replace api.yourdomain.com with your actual domain or IP

{$ATHINA_DOMAIN:localhost} {
    # Reverse proxy all REST and SSE requests
    reverse_proxy backend:8000 {
        # Enable streaming support for SSE chat
        flush_interval -1
    }

    # Enable gzip & zstd compression
    encode zstd gzip

    # Security headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
}
